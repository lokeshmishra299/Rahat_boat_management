/* --------------------  Inspection Schedule  -------------------- */
const Schedule = () => {
  const upcoming = [
    { reg: "UP-AGR-003", district: "Agra District",  due: "2024‑02‑15", days: 15 },
    { reg: "UP-ALL-007", district: "Allahabad District", due: "2024‑02‑20", days: 20 },
