  ];

  return (
    <div className="p-4 md:p-8 grid grid-cols-1 md:grid-cols-2 gap-6">
      {/* Upcoming list */}
      <section className="bg-white p-6 rounded-lg shadow">
        <h2 className="text-2xl font-semibold mb-1">Upcoming Inspections</h2>
        <p className="text-gray-600 mb-4">Boats due for annual inspection</p>

        {upcoming.map((u) => (
          <div
            key={u.reg}
            className="flex justify-between items-center bg-yellow-50 p-4 rounded mb-3"
          >
            <div>
              <div className="font-medium">{u.reg}</div>
              <div className="text-sm text-gray-600">{u.district}</div>
            </div>

            <div className="text-right text-sm">
              <div className="text-gray-700">Due: {u.due}</div>
              <span className="inline-block bg-yellow-100 text-yellow-700 px-2 py-0.5 rounded-full mt-1">
                {u.days} days left
              </span>
            </div>
          </div>
        ))}
      </section>

      {/* Calendar */}
      <section className="bg-white p-6 rounded-lg shadow">
        <h2 className="text-2xl font-semibold mb-1">Inspection Calendar</h2>
        <p className="text-gray-600 mb-4">Monthly inspection schedule overview</p>


        <div className="grid grid-cols-7 gap-2 text-center text-sm text-gray-700 mb-4">
          {["Sun","Mon","Tue","Wed","Thu","Fri","Sat"].map((d)=>(
            <div key={d} className="font-medium">{d}</div>
          ))}
          {Array.from({ length: 35 }).map((_, i) => (
            <div
              key={i}
              className="h-10 flex items-center justify-center rounded border border-gray-200"
            >
              {i > 2 && i - 2}
            </div>
          ))}
        </div>

    
        <div className="flex space-x-6 text-sm">
          {[
            ["bg-red-200"   , "Overdue"   ],
            ["bg-yellow-200", "Due Soon"  ],
            ["bg-green-200" , "Completed" ],
          ].map(([clr, lbl]) => (
            <div key={lbl} className="flex items-center space-x-1">
              <div className={`w-3 h-3 ${clr} rounded-full`} />
              <span>{lbl}</span>
            </div>
          ))}
        </div>
      </section>
    </div>
  );
};


/* --------------------  Analytics  -------------------- */
const Analytics = () => {
  
  const kpis = [
    { label: "Total Boats", value: 1247,  sub: "Registered fleet", color: "bg-blue-500" },
    { label: "Inspected",   value: 856,   sub: "This year",        color: "bg-green-500" },
    { label: "Pass Rate",   value: "87%", sub: "Success rate",     color: "bg-violet-500" },
    { label: "Pending",     value: 391,   sub: "Awaiting inspection", color: "bg-orange-500" },
  ];

  /* status numbers */
  const passed = 742, failed = 67, conditional = 47;
  const inspected = passed + failed + conditional; // 856
  const total = 1247;
  const pct = ((inspected / total) * 100).toFixed(1) + "%";

  return (
    <div className="p-4 md:p-8 space-y-8">
      {/* KPI cards */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {kpis.map((k) => (
          <div key={k.label} className="bg-white p-6 rounded-lg shadow relative">
            {/* colored dot */}
            <span className={`absolute top-4 right-4 w-3 h-3 rounded-full ${k.color}`} />
            <p className="text-sm font-medium text-gray-600">{k.label}</p>
            <p className="text-3xl font-bold mt-1">{k.value}</p>
            <p className="text-xs text-gray-500 mt-0.5">{k.sub}</p>
          </div>
        ))}
      </div>

      {/* Status Overview */}
      <section className="bg-white p-6 rounded-lg shadow space-y-4">
        <h2 className="text-2xl font-semibold">Inspection Status Overview</h2>
        <p className="text-gray-600 text-sm">Current year inspection completion status</p>

        {/* progress bar */}
        <div className="relative w-full h-3 bg-gray-200 rounded">
          <div
            className="absolute top-0 left-0 h-3 bg-gray-900 rounded"
            style={{ width: pct }}
          />
          <span className="absolute right-0 -top-6 text-sm text-gray-600">
            {inspected}/{total}
          </span>
        </div>

        {/* status buckets */}
        <div className="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div className="bg-green-50 text-center py-6 rounded">
            <p className="text-3xl font-bold text-green-600">{passed}</p>
            <p className="mt-1 text-sm text-green-700">Passed</p>
          </div>
          <div className="bg-red-50 text-center py-6 rounded">
            <p className="text-3xl font-bold text-red-600">{failed}</p>
            <p className="mt-1 text-sm text-red-700">Failed</p>
          </div>
          <div className="bg-yellow-50 text-center py-6 rounded">
            <p className="text-3xl font-bold text-yellow-700">{conditional}</p>
            <p className="mt-1 text-sm text-yellow-800">Conditional</p>
          </div>
        </div>
      </section>
    </div>
  );
};

export default Inspection;
